<mvc:View
    controllerName="animal.adoption.userdashboard.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page
        id="dashboardPage"
        title="User Dashboard">

        <content>

            <VBox
                id="mainVBox"
                class="dashboardPage">

                <!-- WELCOME SECTION -->
                <VBox
                    id="welcomeBox"
                    class="welcomeCard">

                    <Title
                        id="userDashboardTitle"
                        text="Welcome to Animal Adoption Tracker"
                        class="welcomeTitle" />

                    <Text
                        id="welcomeSubtitle"
                        text="Manage your applications, adoptions and profile in one place."
                        class="welcomeSubtitle" />

                </VBox>


                <!-- SUMMARY -->
                <Title
                    id="summaryTitle"
                    text="My Summary"
                    level="H2"
                    class="sectionTitle" />

                <HBox
                    id="kpiHBox"
                    wrap="Wrap"
                    justifyContent="SpaceBetween"
                    class="cardRow">

                    <!-- TOTAL -->
                    <GenericTile
                        id="totalApplicationsTile"
                        header="Total Applications"
                        class="dashboardTile kpiTotal">

                        <TileContent id="totalApplicationsContent">

                            <NumericContent
                                id="totalApplicationsCount"
                                value="{dashboard>/myApplications}"
                                class="kpiNumber" />

                        </TileContent>

                    </GenericTile>


                    <!-- PENDING -->
                    <GenericTile
                        id="pendingApplicationsTile"
                        header="Pending Applications"
                        class="dashboardTile kpiPending">

                        <TileContent id="pendingApplicationsContent">

                            <NumericContent
                                id="pendingApplicationsCount"
                                value="{dashboard>/pendingApplications}"
                                valueColor="Critical"
                                class="kpiNumber" />

                        </TileContent>

                    </GenericTile>


                    <!-- APPROVED -->
                    <GenericTile
                        id="approvedApplicationsTile"
                        header="Approved Applications"
                        class="dashboardTile kpiApproved">

                        <TileContent id="approvedApplicationsContent">

                            <NumericContent
                                id="approvedApplicationsCount"
                                value="{dashboard>/approvedApplications}"
                                valueColor="Good"
                                class="kpiNumber" />

                        </TileContent>

                    </GenericTile>

                </HBox>


                <!-- SERVICES -->
                <Title
                    id="servicesTitle"
                    text="Services"
                    level="H2"
                    class="sectionTitle servicesTitle" />

                <Text
                    id="servicesSubtitle"
                    text="Quick access to your adoption activities"
                    class="servicesSubtitle" />


                <HBox
                    id="navigationHBox"
                    wrap="Wrap"
                    justifyContent="SpaceBetween"
                    class="cardRow servicesRow">

                    <!-- BROWSE ANIMALS -->
                    <GenericTile
                        id="browseAnimalsTile"
                        header="Browse Animals"
                        subheader="View Available Animals"
                        press=".onBrowseAnimalsPress"
                        class="dashboardTile serviceTile browseTile">

                        <TileContent id="browseAnimalsTileContent">

                            <ImageContent
                                id="browseAnimalsImage"
                                src="sap-icon://pet-care" />

                        </TileContent>

                    </GenericTile>


                    <!-- APPLICATIONS -->
                    <GenericTile
                        id="myApplicationsTile"
                        header="My Applications"
                        subheader="Track Your Requests"
                        press=".onMyApplicationsPress"
                        class="dashboardTile serviceTile applicationTile">

                        <TileContent id="myApplicationsTileContent">

                            <ImageContent
                                id="myApplicationsImage"
                                src="sap-icon://document" />

                        </TileContent>

                    </GenericTile>


                    <!-- ADOPTIONS -->
                    <GenericTile
                        id="myAdoptionsTile"
                        header="My Adoptions"
                        subheader="View Adoption History"
                        press=".onMyAdoptionsPress"
                        class="dashboardTile serviceTile adoptionTile">

                        <TileContent id="myAdoptionsTileContent">

                            <ImageContent
                                id="myAdoptionsImage"
                                src="sap-icon://accept" />

                        </TileContent>

                    </GenericTile>


                    <!-- PROFILE -->
                    <GenericTile
                        id="profileTile"
                        header="My Profile"
                        subheader="Manage Your Profile"
                        press=".onProfilePress"
                        class="dashboardTile serviceTile profileTile">

                        <TileContent id="profileTileContent">

                            <ImageContent
                                id="profileImage"
                                src="sap-icon://employee" />

                        </TileContent>

                    </GenericTile>

                </HBox>

            </VBox>

        </content>

    </Page>

</mvc:View>